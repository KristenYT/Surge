#!name=YouTube Aioneas 去廣告 + Maasea 字幕 + 繁中修正
#!desc=Aioneas 去廣告；僅移植 Maasea 字幕功能；繁中先取 zh-Hans，再用 OpenCC cn→twp 轉換。腳本由 GitHub raw 載入，不需本機匯入。請停用其他 YouTube 改寫模組。
#!category=YouTube
#!arguments=字幕翻譯語言:zh-Hant,隱藏上傳按鈕:true,隱藏選段按鈕:false,隱藏Shorts按鈕:false,除錯:false
#!arguments-desc=字幕預設 zh-Hant；off 關閉自動新增翻譯軌。繁中修正仍適用手動選取的繁中自動翻譯。不是為無字幕影片產生字幕。

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad data-type=text data=" " status-code=200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads data-type=text data=" " status-code=200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) data-type=text data=" " status-code=200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext data-type=text data=" " status-code=200

[Script]
yt.integrated.response = type=http-response, pattern=^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\?|$), script-path=https://raw.githubusercontent.com/KristenYT/Surge/main/Youtube/youtube.response.js, argument="{"lyricLang":"off","captionLang":"{{{字幕翻譯語言}}}","blockUpload":{{{隱藏上傳按鈕}}},"blockImmersive":{{{隱藏選段按鈕}}},"blockShorts":{{{隱藏Shorts按鈕}}},"debug":{{{除錯}}}}", requires-body=true, binary-body-mode=true, max-size=-1, timeout=60
yt.tc.request = type=http-request, pattern=^https:\/\/(?:(?:www\.|m\.)?youtube\.com|video\.google\.com)\/api\/timedtext\?.*tlang=zh-Hant, script-path=https://raw.githubusercontent.com/KristenYT/Surge/main/Youtube/youtube.tc.request.js, timeout=10
yt.tc.response = type=http-response, pattern=^https:\/\/(?:(?:www\.|m\.)?youtube\.com|video\.google\.com)\/api\/timedtext\?.*tlang=zh-Hant, script-path=https://raw.githubusercontent.com/KristenYT/Surge/main/Youtube/youtube.tc.response.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, video.google.com, youtubei.googleapis.com
